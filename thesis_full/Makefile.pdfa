# Build the complete thesis as PDF/A-2b without changing the normal latexmk build.
# PDF/A-3a needs a tagged source PDF; Ghostscript supports level b only.
# Run from this directory: make -f Makefile.pdfa

.DEFAULT_GOAL := pdfa

LATEXMK ?= latexmk
GS ?= gs
VERAPDF ?= verapdf
ICC_PROFILE ?= /usr/share/color/icc/ghostscript/srgb.icc

ARTIFACTS := build/pdfa/artefacts
WRAPPER := $(ARTIFACTS)/thesis_full_latex_intermediate.tex
LATEXMK_RC := $(ARTIFACTS)/pdfa.latexmkrc
SOURCE := $(ARTIFACTS)/thesis_full_latex_intermediate.pdf
OUTPUT := build/pdfa/thesis_full_pdfa2b.pdf
PDFA_PS := $(ARTIFACTS)/pdfa_def.ps
REPORT := $(ARTIFACTS)/verapdf-report.xml

.PHONY: pdfa latex verify

latex:
	@mkdir -p "$(ARTIFACTS)"
	@printf '%s\n' \
		'\PassOptionsToPackage{pdfa}{hyperref}' \
		'\AtBeginDocument{\svgsetup{inkscapepath=./build/pdfa/artefacts/svg-inkscape/}}' \
		'\input{thesis_full.tex}' > "$(WRAPPER)"
	@printf '%s\n' \
		'$$out_dir = "build/pdfa/artefacts";' \
		'use Cwd qw(abs_path);' \
		'use File::Path qw(make_path);' \
		'make_path($$out_dir);' \
		'my $$pdfa_dir = abs_path($$out_dir);' \
		'$$ENV{"INKSCAPE_PROFILE_DIR"} = "$$pdfa_dir/inkscape-profile";' \
		'$$ENV{"XDG_CONFIG_HOME"} = "$$pdfa_dir/config";' \
		'$$ENV{"XDG_CACHE_HOME"} = "$$pdfa_dir/cache";' \
		'make_path(@ENV{qw(INKSCAPE_PROFILE_DIR XDG_CONFIG_HOME XDG_CACHE_HOME)});' \
		> "$(LATEXMK_RC)"
	$(LATEXMK) -norc -r .latexmkrc -r "$(LATEXMK_RC)" -pdf \
		-outdir="$(ARTIFACTS)" -interaction=nonstopmode -halt-on-error "$(WRAPPER)"

pdfa: latex
	@test -r "$(ICC_PROFILE)" || { printf 'ICC profile not readable: %s\nSet ICC_PROFILE to an sRGB ICC profile.\n' "$(ICC_PROFILE)"; exit 1; }
	@mkdir -p "$(ARTIFACTS)"
	@printf '%s\n' \
		'%!' \
		'% PDF/A output intent; generated by Makefile.pdfa.' \
		'/ICCProfile systemdict /PDFaICCProfile get def' \
		'[/_objdef {icc_PDFA} /type /stream /OBJ pdfmark' \
		'[{icc_PDFA} << /N 3 >> /PUT pdfmark' \
		'[{icc_PDFA} ICCProfile (r) file /PUT pdfmark' \
		'[/_objdef {OutputIntent_PDFA} /type /dict /OBJ pdfmark' \
		'[{OutputIntent_PDFA} <<' \
		'  /Type /OutputIntent' \
		'  /S /GTS_PDFA1' \
		'  /DestOutputProfile {icc_PDFA}' \
		'  /OutputConditionIdentifier (sRGB)' \
		'>> /PUT pdfmark' \
		'[{Catalog} <</OutputIntents [ {OutputIntent_PDFA} ]>> /PUT pdfmark' \
		> "$(PDFA_PS)"
	$(GS) -dBATCH -dNOPAUSE -dSAFER \
		--permit-file-read="$(ICC_PROFILE)" \
		-dPDFA=2 -dPDFACompatibilityPolicy=2 \
		-sColorConversionStrategy=RGB -sDEVICE=pdfwrite \
		-sPDFaICCProfile="$(ICC_PROFILE)" \
		-sOutputFile="$(OUTPUT)" "$(PDFA_PS)" "$(SOURCE)"
	@printf 'Generated %s (PDF/A-2b).\n' "$(OUTPUT)"

# Independent conformance check (requires veraPDF, which is not part of TeX Live).
verify: pdfa
	@command -v "$(VERAPDF)" >/dev/null || { printf 'veraPDF is required for independent PDF/A validation.\n'; exit 1; }
	$(VERAPDF) --format xml "$(OUTPUT)" > "$(REPORT)"
	@grep -q 'profileName="PDF/A-2b validation profile"' "$(REPORT)" || { printf 'PDF/A-2b profile was not detected; see %s\n' "$(REPORT)"; exit 1; }
	@grep -q 'isCompliant="true"' "$(REPORT)" || { printf 'PDF/A-2b validation failed; see %s\n' "$(REPORT)"; exit 1; }
	@printf 'PDF/A-2b validation passed; report: %s\n' "$(REPORT)"
